# ─── Firefox WebRTC viewer (RHEL 9 + NVIDIA NVDEC via VAAPI, decode-only) ────
# Runs Firefox against the *host's* X server (mount /tmp/.X11-unix) under the
# NVIDIA Container Toolkit. Hardware H264 decode via NVDEC; no encoder, no
# headless display — this is a viewer, nothing else.
#
# Run (example):
#   xhost +local:                       # one-time on host, or mount ~/.Xauthority
#   podman run --rm \
#       --device nvidia.com/gpu=all \
#       -e NVIDIA_DRIVER_CAPABILITIES=compute,video,graphics,utility \
#       -e DISPLAY \
#       -v /tmp/.X11-unix:/tmp/.X11-unix:ro \
#       -v "${XDG_RUNTIME_DIR}/pulse:/run/pulse:ro" \
#       -e PULSE_SERVER=/run/pulse/native \
#       firefox-webrtc:latest
#
# Wired up:
#   • Firefox ESR (Rocky 9 AppStream)
#   • libva + nvidia-vaapi-driver  → VAAPI calls routed to NVDEC
#   • ffmpeg-libs                  → Firefox's RDD process loads it for H264 decode
#   • libglvnd + mesa-libGL/EGL    → GLVND dispatch; NVIDIA libs come from the toolkit
FROM registry.access.redhat.com/ubi9/ubi:latest

# ── Repos: Rocky 9 supplement + EPEL 9 + RPM Fusion (free + nonfree) ─────────
# UBI9 alone doesn't ship firefox; Rocky 9 AppStream does. RPM Fusion nonfree
# provides nvidia-vaapi-driver (EL9 keeps the old name; Fedora renamed it
# libva-nvidia-driver). RPM Fusion free provides full ffmpeg-libs with H264.
RUN rpm --import https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-rockyofficial \
    && rpm --import https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9 \
    && printf '%s\n' \
        '[rocky9-baseos]' \
        'name=Rocky Linux 9 - BaseOS' \
        'baseurl=https://dl.rockylinux.org/pub/rocky/9/BaseOS/$basearch/os/' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-rockyofficial' \
        '       https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9' \
        'priority=100' \
        '' \
        '[rocky9-appstream]' \
        'name=Rocky Linux 9 - AppStream' \
        'baseurl=https://dl.rockylinux.org/pub/rocky/9/AppStream/$basearch/os/' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-rockyofficial' \
        '       https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9' \
        'priority=100' \
        '' \
        '[rocky9-crb]' \
        'name=Rocky Linux 9 - CRB' \
        'baseurl=https://dl.rockylinux.org/pub/rocky/9/CRB/$basearch/os/' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9' \
        'priority=100' \
        > /etc/yum.repos.d/rocky9-supplement.repo \
    && dnf install -y \
        https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
        https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-9.noarch.rpm \
        https://mirrors.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-9.noarch.rpm \
    && dnf clean all

# ── Runtime packages ─────────────────────────────────────────────────────────
# nvidia-vaapi-driver installs /usr/lib64/dri/nvidia_drv_video.so and dlopen's
# libcuda.so.1 / libnvcuvid.so.1 — those come from the host via the NVIDIA
# Container Toolkit, not from this image.
RUN dnf install -y \
        --setopt=install_weak_deps=False \
        --setopt=tsflags=nodocs \
        firefox \
        libva \
        libva-utils \
        nvidia-vaapi-driver \
        ffmpeg-libs \
        mesa-libGL \
        mesa-libEGL \
        libglvnd-glx \
        libglvnd-egl \
        libdrm \
        xorg-x11-xauth \
        xorg-x11-utils \
        dbus-libs \
        pulseaudio-libs \
        pulseaudio-utils \
        liberation-fonts \
        dejavu-sans-fonts \
        procps-ng \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum /var/log/dnf* \
              /usr/share/doc /usr/share/man /usr/share/info

# ── glvnd / EGL ICD wiring ───────────────────────────────────────────────────
# The NVIDIA Container Toolkit mounts /usr/share/glvnd/egl_vendor.d/10_nvidia.json
# from the host. Pinning the loader names here is belt-and-braces.
ENV __GLX_VENDOR_LIBRARY_NAME=nvidia \
    __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json

# ── Firefox global autoconfig (HW decode prefs locked at startup) ────────────
# autoconfig.js → firefox.cfg is the only way to ship "system defaults" that
# survive a fresh -p profile and don't require pre-populating prefs.js.
COPY autoconfig.js  /usr/lib64/firefox/defaults/pref/autoconfig.js
COPY firefox.cfg    /usr/lib64/firefox/firefox.cfg
COPY policies.json  /usr/lib64/firefox/distribution/policies.json

# ── Environment defaults for HW-accelerated WebRTC decode ────────────────────
# LIBVA_DRIVER_NAME=nvidia   → libva loads nvidia_drv_video.so
# NVD_BACKEND=direct         → nvidia-vaapi-driver bypasses EGL surface, uses CUDA directly
# MOZ_X11_EGL=1              → Firefox uses EGL (required for VAAPI dmabuf import)
# MOZ_DISABLE_RDD_SANDBOX=1  → RDD sandbox would block /dev/nvidia* opens
# NVIDIA_DRIVER_CAPABILITIES → consumed by nvidia-container-toolkit at run time:
#                              `video` (NVDEC) + `compute` (CUDA) + `graphics` (EGL)
ENV LIBVA_DRIVER_NAME=nvidia \
    NVD_BACKEND=direct \
    MOZ_X11_EGL=1 \
    MOZ_DISABLE_RDD_SANDBOX=1 \
    MOZ_ENABLE_WAYLAND=0 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,video,graphics,utility \
    HOME=/home/firefox

# ── Non-root user (Firefox refuses to run as root). UID 1000 matches the most
# common host desktop UID; override with `--user $(id -u):$(id -g)` if yours
# differs, otherwise ~/.Xauthority won't be readable.
RUN useradd -m -u 1000 -s /bin/bash firefox \
    && mkdir -p /home/firefox/.mozilla \
    && chown -R firefox:firefox /home/firefox

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER firefox
WORKDIR /home/firefox

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["firefox", "--no-remote", "--new-instance"]
