# desktop-stream-hub APP image — the OFFLINE application phase.
#
# Layers the in-repo application onto the prebuilt base image from
# hub/Containerfile.base.  COPY and chmod only — no network — so this
# builds air-gapped as long as the base image is in local storage
# (`make setup` builds it online).  Build with `--pull=never`
# (make OFFLINE=1) to guarantee no registry access is attempted.
ARG BASE_IMAGE=desktop-stream-hub-base:ci
FROM ${BASE_IMAGE}

COPY web/           /etc/hub/web/
COPY web_server.py  /usr/local/bin/web_server.py
COPY entrypoint.sh  /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/web_server.py /usr/local/bin/entrypoint.sh

ENV WEB_PORT=8080 \
    WEB_DIR=/etc/hub/web

EXPOSE 8080/tcp

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
