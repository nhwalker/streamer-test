# desktop-stream-hub BASE image — the ONLINE setup phase.
#
# Pulls in every third-party component (just UBI's python3) and nothing
# from this repository; the application is layered on by hub/Containerfile,
# which builds fully offline once this image exists locally.
#
# Pinned to the current minor — bump alongside service/Containerfile.base
# each RHEL 9.x release.
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

RUN microdnf install -y python3 && microdnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf*
