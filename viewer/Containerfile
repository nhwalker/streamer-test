# ─── Desktop-stream Viewer ────────────────────────────────────────────────────
# Electron app that opens the hub's WebRTC viewer page with hardware H.264
# decode via VA-API → NVDEC (using elFarto's nvidia-vaapi-driver). Decode only;
# no encoder is configured. The container is meant to be launched against a
# real host X11 socket — no Xvfb, no virtual display.
#
# Build order:
#   podman build -t desktop-stream-viewer viewer/
#
# Run (host X11):
#   xhost +local:root
#   podman run --rm \
#       --device nvidia.com/gpu=all \
#       -e DISPLAY=$DISPLAY \
#       -e VIEWER_URL=http://hub-host:8080/ \
#       -v /tmp/.X11-unix:/tmp/.X11-unix \
#       --net=host \
#       desktop-stream-viewer

# ── Stage 0: shared repo configuration ───────────────────────────────────────
FROM registry.access.redhat.com/ubi10/ubi:latest AS rocky-repos

RUN rpm --import https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-rockyofficial \
    && rpm --import https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-10 \
    && printf '%s\n' \
        '[rocky10-baseos]' \
        'name=Rocky Linux 10 - BaseOS' \
        'baseurl=https://dl.rockylinux.org/pub/rocky/10/BaseOS/$basearch/os/' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-rockyofficial' \
        '       https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-10' \
        'priority=100' \
        '' \
        '[rocky10-appstream]' \
        'name=Rocky Linux 10 - AppStream' \
        'baseurl=https://dl.rockylinux.org/pub/rocky/10/AppStream/$basearch/os/' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-rockyofficial' \
        '       https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-10' \
        'priority=100' \
        '' \
        '[rocky10-crb]' \
        'name=Rocky Linux 10 - CRB' \
        'baseurl=https://dl.rockylinux.org/pub/rocky/10/CRB/$basearch/os/' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-10' \
        'priority=100' \
        > /etc/yum.repos.d/rocky10-supplement.repo \
    && dnf install -y \
        https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm \
    && dnf clean all

# ── Stage 1: build nvidia-vaapi-driver from source ───────────────────────────
# Chromium on Linux only routes WebRTC video through VA-API; NVENC/NVDEC is
# reached via a libva backend that translates VA-API calls to NVDEC. We need
# nv-codec-headers (for the CUDA video API headers) plus libva headers and
# gst-plugins-bad's codecparsers helpers.
FROM rocky-repos AS vaapi-builder

RUN dnf install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        gcc make git pkgconf-pkg-config \
        meson ninja-build \
        libva-devel \
        glib2-devel \
        gstreamer1-plugins-bad-free-devel \
        libglvnd-devel \
    && dnf clean all

ARG NV_CODEC_HEADERS_TAG=n12.2.72.0
RUN git clone --depth 1 --branch "${NV_CODEC_HEADERS_TAG}" \
        https://github.com/FFmpeg/nv-codec-headers.git /nv-codec-headers \
    && make -C /nv-codec-headers PREFIX=/usr install \
    && rm -rf /nv-codec-headers

ARG NVIDIA_VAAPI_DRIVER_TAG=v0.0.12
RUN git clone --depth 1 --branch "${NVIDIA_VAAPI_DRIVER_TAG}" \
        https://github.com/elFarto/nvidia-vaapi-driver.git /src \
    && cd /src \
    && meson setup build \
           --prefix=/usr \
           --libdir=lib64 \
           --buildtype=release \
    && meson compile -C build \
    && DESTDIR=/out meson install -C build \
    && find /out -name 'nvidia_drv_video.so'

# ── Stage 2: install Electron + bundle the app ───────────────────────────────
FROM rocky-repos AS app-builder

RUN dnf install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        nodejs npm \
    && dnf clean all

WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund --loglevel=error
COPY main.js ./

# ── Stage 3: runtime ─────────────────────────────────────────────────────────
FROM rocky-repos AS runtime

# Chromium / Electron shared-library dependencies, libva runtime, Node (to run
# the electron launcher script), and a few X11 utilities for debugging.
RUN dnf install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        nss nspr \
        atk at-spi2-atk at-spi2-core \
        cups-libs \
        libdrm libgbm libxkbcommon \
        mesa-libEGL mesa-libGL \
        libX11 libXcomposite libXdamage libXext libXfixes \
        libXrandr libXrender libXScrnSaver libXtst libXi \
        libxcb libxshmfence libsecret \
        pango cairo gtk3 alsa-lib \
        libva libva-utils \
        nodejs \
        xorg-x11-utils \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf* \
              /usr/share/doc /usr/share/man /usr/share/info

# nvidia-vaapi-driver: a single .so loaded by libva when LIBVA_DRIVER_NAME=nvidia
COPY --from=vaapi-builder /out/usr/lib64/dri/nvidia_drv_video.so \
                          /usr/lib64/dri/nvidia_drv_video.so

# Electron application
COPY --from=app-builder /app /opt/viewer

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# NVIDIA Container Toolkit env: 'video' lets nvcuvid mount in, 'graphics' and
# 'display' bring in the GL/EGL stack, 'compute' is needed by the direct
# (CUDA) backend in nvidia-vaapi-driver.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video,graphics,display \
    LIBVA_DRIVER_NAME=nvidia \
    NVD_BACKEND=direct \
    __GLX_VENDOR_LIBRARY_NAME=nvidia \
    VIEWER_URL=http://localhost:8080/ \
    VIEWER_FULLSCREEN=0 \
    VIEWER_KIOSK=0

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
