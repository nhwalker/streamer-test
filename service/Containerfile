# desktop-stream-service: ffmpeg (x11grab + NVENC) -> MediaMTX (WebRTC/WHEP).
#
# Single-stage build — no source compilation.  Everything comes from
# mirror-able RPM repositories (Rocky 10 / EPEL 10 / RPM Fusion Free) except
# MediaMTX, which is a single static Go binary vendored from a pinned release
# (override MEDIAMTX_URL to pull it from an internal artifact store on
# air-gapped builders).
FROM registry.access.redhat.com/ubi10/ubi:latest

# ── Repos: Rocky 10 + EPEL10 + RPM Fusion Free ───────────────────────────────
RUN rpm --import https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-rockyofficial \
    && rpm --import https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-10 \
    && printf '%s\n' \
        '[rocky10-baseos]' \
        'name=Rocky Linux 10 - BaseOS' \
        'baseurl=https://dl.rockylinux.org/pub/rocky/10/BaseOS/$basearch/os/' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-rockyofficial' \
        '       https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-10' \
        'priority=100' \
        '' \
        '[rocky10-appstream]' \
        'name=Rocky Linux 10 - AppStream' \
        'baseurl=https://dl.rockylinux.org/pub/rocky/10/AppStream/$basearch/os/' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-rockyofficial' \
        '       https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-10' \
        'priority=100' \
        '' \
        '[rocky10-crb]' \
        'name=Rocky Linux 10 - CRB' \
        'baseurl=https://dl.rockylinux.org/pub/rocky/10/CRB/$basearch/os/' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-rockyofficial' \
        '       https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-10' \
        'priority=100' \
        > /etc/yum.repos.d/rocky10-supplement.repo \
    && dnf install -y \
        https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm \
        https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-10.noarch.rpm \
    && dnf clean all

# ── Runtime packages ─────────────────────────────────────────────────────────
# ffmpeg comes from RPM Fusion Free (full build: h264_nvenc, libx264,
# libopus, x11grab).  Do NOT let EPEL's stripped ffmpeg-free variant in —
# it conflicts with RPM Fusion's ffmpeg-libs and lacks NVENC.
RUN dnf install -y \
        --setopt=install_weak_deps=False \
        --setopt=tsflags=nodocs \
        ffmpeg \
        python3 \
        python3-pip \
        nmap-ncat \
        tar \
    && pip3 install --no-cache-dir --root-user-action=ignore python-xlib \
    && ffmpeg -hide_banner -encoders | grep -q h264_nvenc \
    && ffmpeg -hide_banner -devices  | grep -q x11grab \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum /var/log/dnf* \
              /usr/share/doc /usr/share/man /usr/share/info \
              /root/.cache/pip

# ── MediaMTX (vendored release binary) ───────────────────────────────────────
# Pinned version + checksum.  Air-gapped builds: pass
#   --build-arg MEDIAMTX_URL=https://artifacts.internal/…/mediamtx.tar.gz
# pointing at the mirrored tarball (and keep MEDIAMTX_SHA256 in sync when
# bumping the version).
ARG MEDIAMTX_VERSION=v1.19.2
ARG MEDIAMTX_URL=https://github.com/bluenviron/mediamtx/releases/download/${MEDIAMTX_VERSION}/mediamtx_${MEDIAMTX_VERSION}_linux_amd64.tar.gz
ARG MEDIAMTX_SHA256=""
RUN curl -fsSL -o /tmp/mediamtx.tar.gz "${MEDIAMTX_URL}" \
    && if [ -n "${MEDIAMTX_SHA256}" ]; then \
           echo "${MEDIAMTX_SHA256}  /tmp/mediamtx.tar.gz" | sha256sum -c -; \
       else \
           echo "WARNING: MEDIAMTX_SHA256 not set — skipping checksum check"; \
       fi \
    && tar -xzf /tmp/mediamtx.tar.gz -C /usr/local/bin mediamtx \
    && rm /tmp/mediamtx.tar.gz \
    && /usr/local/bin/mediamtx --version

# ── Web page ─────────────────────────────────────────────────────────────────
# Static page + stylesheet + WHEP client script — no JS build step, no bundle.
COPY web/ /var/www/html/

# ── Application scripts ───────────────────────────────────────────────────────
COPY entrypoint.sh        /usr/local/bin/entrypoint.sh
COPY pipeline.py          /usr/local/bin/pipeline.py
COPY stream_command.py    /usr/local/bin/stream_command.py
COPY web_server.py        /usr/local/bin/web_server.py
COPY archive_encoder.py   /usr/local/bin/archive_encoder.py
COPY archive_export.py    /usr/local/bin/archive_export.py
COPY archive_finalize.py  /usr/local/bin/archive_finalize.py
COPY archive_purge.py     /usr/local/bin/archive_purge.py
COPY archive_times.py     /usr/local/bin/archive_times.py
COPY encoders.py          /usr/local/bin/encoders.py
COPY video_transcode.py   /usr/local/bin/video_transcode.py
COPY desktop_config.py    /usr/local/bin/desktop_config.py
COPY x11.py               /usr/local/bin/x11.py
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/pipeline.py \
             /usr/local/bin/stream_command.py /usr/local/bin/web_server.py

# ── Default archive volumes ───────────────────────────────────────────────────
# /archive holds completed (timestamp-named) segments.
# /archive-live holds the in-progress segment until ffmpeg rotates it, then
# it's moved into /archive.  Keeping live segments separate lets operators
# put them on a different (e.g. faster, ephemeral) filesystem.
VOLUME /archive
VOLUME /archive-live

# ── Environment defaults (all overridable at runtime via -e) ────────────────
# STREAM_WIDTH/STREAM_HEIGHT and DESKTOP_SPLITS are intentionally unset —
# the runtime auto-detects native screen size + monitor geometry via RandR.
ENV DISPLAY=:0 \
    DESKTOP_NAME=desktop \
    STREAM_FRAMERATE=30 \
    ARCHIVE_DIR=/archive \
    ARCHIVE_LIVE_DIR=/archive-live \
    ARCHIVE_SEGMENT_SEC=600 \
    ARCHIVE_BITRATE=6000 \
    WEB_PORT=8080 \
    MEDIAMTX_RTSP_PORT=8554 \
    WEBRTC_PORT=8889 \
    WEBRTC_UDP_PORT=8189 \
    WEBRTC_ADDITIONAL_HOSTS="" \
    LIVE_CQ=18 \
    LIVE_MAXRATE=8M \
    VIDEO_FILL_COLOR=0xFF000000 \
    VIDEO_DEFAULT_WIDTH=1920 \
    VIDEO_DEFAULT_HEIGHT=1080 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=video,compute

# Web UI.
EXPOSE 8080/tcp
# MediaMTX WHEP (HTTP signalling) + ICE/UDP media.
EXPOSE 8889/tcp
EXPOSE 8189/udp

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
